# ============================================================================
# Stripe Configuration
# ============================================================================
#
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env.local
# 2. Sign up at https://dashboard.stripe.com (free, no credit card required)
# 3. Get your test API keys from: https://dashboard.stripe.com/test/apikeys
# 4. Fill in the values below
# 5. For webhooks, see "Webhook Setup" section below
#
# SECURITY:
# - .env.local is git-ignored and NEVER committed to version control
# - Use test keys (pk_test_*, sk_test_*) for development
# - Use live keys (pk_live_*, sk_live_*) ONLY in production
#
# ============================================================================

# ----------------------------------------------------------------------------
# Stripe Publishable Key (Client-Safe)
# ----------------------------------------------------------------------------
# This key is safe to expose in your frontend JavaScript bundle.
# It's used by Stripe.js to tokenize payment methods securely.
#
# Get from: https://dashboard.stripe.com/test/apikeys
# Format: pk_test_51ABC...
#
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ----------------------------------------------------------------------------
# Stripe Secret Key (Server-Only - CRITICAL)
# ----------------------------------------------------------------------------
# WARNING: This key has FULL access to your Stripe account!
# - NEVER expose this in client code
# - NEVER commit this to git
# - Only use in API routes (app/api/**/route.ts)
#
# Get from: https://dashboard.stripe.com/test/apikeys
# Format: sk_test_51ABC...
#
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# ----------------------------------------------------------------------------
# Stripe Webhook Secret (For Event Verification)
# ----------------------------------------------------------------------------
# Used to verify that webhook events actually came from Stripe.
# Required to prevent spoofed webhook attacks.
#
# DEVELOPMENT:
# 1. Install Stripe CLI: brew install stripe/stripe-cli/stripe
# 2. Login: stripe login
# 3. Forward webhooks: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# 4. Copy the webhook signing secret (whsec_...) from terminal output
#
# PRODUCTION:
# 1. Go to: https://dashboard.stripe.com/webhooks
# 2. Click "+ Add endpoint"
# 3. Enter URL: https://your-domain.com/api/webhooks/stripe
# 4. Select events: payment_intent.succeeded, payment_intent.payment_failed
# 5. Copy the webhook signing secret (whsec_...)
#
# Format: whsec_ABC...
#
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ----------------------------------------------------------------------------
# Application URL
# ----------------------------------------------------------------------------
# Your application's base URL.
# Used for redirects, metadata, and webhook configuration.
#
# Development: http://localhost:3000
# Production: https://pregradeessentials.com
#
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# Quick Start Testing (After setup)
# ============================================================================
#
# 1. Start dev server:
#    npm run dev
#
# 2. In separate terminal, start webhook listener:
#    stripe listen --forward-to localhost:3000/api/webhooks/stripe
#
# 3. Use test cards:
#    Success:          4242 4242 4242 4242
#    Requires auth:    4000 0025 0000 3155
#    Declined:         4000 0000 0000 0002
#    Insufficient:     4000 0000 0000 9995
#
#    Any future expiry date, any 3-digit CVC
#
# 4. View payments:
#    https://dashboard.stripe.com/test/payments
#
# ============================================================================
